---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const projects = await getCollection('projects');
const projectItems = projects.sort((a, b) => a.data.weight - b.data.weight);
const currentProjects = projectItems.filter(project => project.data.status === 'current');
const selectedProjects = projectItems.filter(project => project.data.status === 'selected');
---

<BaseLayout title="Work | Cameron Durham">
  <header class="work-header">
    <h1>Work</h1>
  </header>

  {currentProjects.length > 0 && (
    <section class="section-block" aria-labelledby="current-heading">
      <h2 id="current-heading">Current</h2>
      <div class="tool-list current-projects">
        {currentProjects.map(project => (
          <article class="tool">
            <h3>
              {project.data.link ? (
                <a href={project.data.link} target="_blank" rel="noopener noreferrer">{project.data.title}</a>
              ) : (
                project.data.title
              )}
            </h3>
            {project.data.description && <p>{project.data.description}</p>}
          </article>
        ))}
      </div>
    </section>
  )}

  {selectedProjects.length > 0 && (
    <section class="section-block" aria-labelledby="selected-heading">
      <h2 id="selected-heading">Selected projects</h2>
      <div class="tool-list">
        {selectedProjects.map(project => (
          <article class="tool">
            <h3>
              {project.data.link ? (
                <a href={project.data.link} target="_blank" rel="noopener noreferrer">{project.data.title}</a>
              ) : (
                project.data.title
              )}
            </h3>
            {project.data.description && <p>{project.data.description}</p>}
          </article>
        ))}
      </div>
    </section>
  )}
</BaseLayout>

<style>
.work-header { margin: 2rem 0; }
.work-header h1 { margin-top: 0; }
.work-header h1::before,
.section-block h2::before,
.tool h3::before {
  content: none;
}

.section-block {
  margin: 2rem 0;
}

.section-block h2 {
  border-bottom: 1px solid var(--border-color);
  font-size: 1.15rem;
  margin: 0 0 1rem;
  padding-bottom: 0.5rem;
}

.tool-list {
  display: grid;
  gap: 1.5rem;
}

.tool h3 {
  font-size: 1.05rem;
  margin: 0 0 0.35rem;
}

.tool-list {
  grid-template-columns: repeat(2, minmax(0, 1fr));
}

.current-projects {
  grid-template-columns: 1fr;
}

.tool {
  border-bottom: 1px solid var(--border-color);
  padding-bottom: 1rem;
}

.tool p {
  color: var(--text-1);
  margin-bottom: 0;
}

@media (max-width: 720px) {
  .tool-list {
    grid-template-columns: 1fr;
  }
}
</style>
