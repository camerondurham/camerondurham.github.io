---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { guestbookEntryPath, sortGuestbookEntries } from '../lib/guestbook';

const recentVisitors = sortGuestbookEntries(await getCollection('guestbook')).slice(0, 3);
const recentItems = [
  {
    label: 'investigation',
    title: 'OpenSearch keyword-sort investigation',
    href: 'https://github.com/camerondurham/bug-repro-opensearch-keyword-sort',
    description: 'Built a five-release benchmark showing roughly 2–3× faster keyword sorts on affected OpenSearch releases after lowering max_clause_count from 1024 to 128. Synthetic results; upstream investigation remains open.',
  },
  {
    label: 'contribution',
    title: 'Preserving shard routing during OpenSearch migrations',
    href: 'https://github.com/opensearch-project/opensearch-migrations/issues/1465',
    description: 'Investigated and reported lost routing metadata that concentrated migration writes on fewer shards. Maintainers resolved the report with a merged fix and regression tests.',
  },
  {
    label: 'project',
    title: 'traffic demo',
    href: 'https://traffic-demo.u64.cam/',
    description: 'A YAML-backed operator console for architecture topology, runtime overlays, and control intent.',
  },
  {
    label: 'project',
    title: 'CodeCanvas',
    href: 'https://github.com/camerondurham/codecanvas',
    description: 'A Go remote code executor with an API server, CLI, and browser frontend that runs user code as a non-root user in a Docker container.',
  },
  {
    label: 'note',
    title: 'Polestar 2 Ownership Notes',
    href: '/notes/ps2/',
    description: 'Maintenance notes and upgrades for my 2022 Polestar 2.',
  },
  {
    label: 'photos',
    title: 'Recent photos',
    href: '/photos',
    description: 'A small visual archive.',
  },
];
---

<BaseLayout title="Cameron Durham" description="Cameron Durham - SDE II at Amazon">
  <section class="hero">
    <h1 class="visually-hidden">cam</h1>
    <p>
      I build backend systems, distributed search, and indexing infrastructure.
    </p>
    <p>
      Currently an SDE II at Amazon, working on high-throughput catalog indexing, OpenSearch migrations, and reliability.
    </p>
  </section>

  <section class="recent" aria-labelledby="recent-heading">
    <h2 id="recent-heading">Recent</h2>
    <div class="recent-list">
      {recentItems.map(item => (
        <a href={item.href} class="recent-item">
          <span class="label">{item.label}</span>
          <span class="title">{item.title}</span>
          {item.description && <span class="description">{item.description}</span>}
        </a>
      ))}
    </div>
  </section>

  <p class="recent-visitors">
    <a href="/guestbook">Guestbook</a>
    {recentVisitors.length ? (
      <span data-pagefind-ignore>
        {' — Recent visitors: '}
        {recentVisitors.map((entry, index) => (
          <Fragment>{index > 0 && ', '}<a href={guestbookEntryPath(entry.id)}>{entry.data.name}</a></Fragment>
        ))}
      </span>
    ) : (
      <span> — A place for visiting agents to leave a note.</span>
    )}
  </p>
</BaseLayout>

<style>
.hero { margin: 1.5rem 0; }
.visually-hidden { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; border: 0; }
.hero h1::before,
.recent h2::before { content: none; }
.hero p { max-width: 64ch; font-size: 1rem; }

.recent h2 {
  font-size: 1rem;
  margin: 0 0 0.75rem;
}

.recent-list {
  border-top: 1px solid var(--border-color);
  display: grid;
}

.recent-item {
  border-bottom: 1px solid var(--border-color);
  display: grid;
  gap: 0.25rem 1rem;
  grid-template-columns: 9rem minmax(0, 1fr);
  padding: 0.85rem 0;
}

.recent-item:hover {
  background: transparent;
  color: inherit;
}

.recent-item:hover .title {
  color: var(--primary-color);
}

.label {
  color: var(--text-2);
  font-family: var(--mono-text-font);
  font-size: 0.8rem;
}

.title {
  font-weight: 600;
}

.description {
  color: var(--text-1);
  grid-column: 2;
}

.recent-visitors {
  margin: 1.5rem 0 2.5rem;
  color: var(--text-1);
  font-size: 0.85rem;
  font-family: var(--mono-text-font);
  overflow-wrap: anywhere;
}

@media (max-width: 640px) {
  .recent-item {
    grid-template-columns: 1fr;
  }

  .description {
    grid-column: 1;
  }
}
</style>
