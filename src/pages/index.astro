---
import BaseLayout from '../layouts/BaseLayout.astro';
const recentItems = [
  {
    label: 'project',
    title: 'traffic demo',
    href: 'https://traffic-demo.u64.cam/',
  },
  {
    label: 'note',
    title: 'Polestar 2 Ownership Notes',
    href: '/notes/ps2/',
    description: 'Maintenance notes and upgrades for my 2022 Polestar 2.',
  },
  {
    label: 'photos',
    title: 'Recent photos',
    href: '/photos',
    description: 'A small visual archive.',
  },
];
---

<BaseLayout title="Cameron Durham" description="Cameron Durham - SDE II at Amazon">
  <section class="hero">
    <h1>Cameron Durham</h1>
    <p>
      I build backend systems and search indexing infrastructure, and contribute to open-source projects I use.
    </p>
    <p>
      Currently at Amazon, working on distributed catalog indexing and related reliability/performance work.
    </p>
  </section>

  <section class="current">
    <p>
      <strong>Current:</strong> <a href="https://traffic-demo.u64.cam/" target="_blank" rel="noopener noreferrer">traffic demo</a>.
    </p>
  </section>

  <section class="recent" aria-labelledby="recent-heading">
    <h2 id="recent-heading">Recent</h2>
    <div class="recent-list">
      {recentItems.map(item => (
        <a href={item.href} class="recent-item">
          <span class="label">{item.label}</span>
          <span class="title">{item.title}</span>
          {item.description && <span class="description">{item.description}</span>}
        </a>
      ))}
    </div>
  </section>
</BaseLayout>

<style>
.hero { margin: 2.5rem 0 1.5rem; }
.hero h1 { margin-top: 0; margin-bottom: 1rem; }
.hero h1::before,
.recent h2::before { content: none; }
.hero p { max-width: 64ch; font-size: 1rem; }

.current {
  border-top: 1px solid var(--border-color);
  border-bottom: 1px solid var(--border-color);
  color: var(--text-1);
  margin: 1.75rem 0 2rem;
  padding: 0.85rem 0;
}

.current p { margin: 0; }

.recent h2 {
  font-size: 1rem;
  margin: 0 0 0.75rem;
}

.recent-list {
  border-top: 1px solid var(--border-color);
  display: grid;
}

.recent-item {
  border-bottom: 1px solid var(--border-color);
  display: grid;
  gap: 0.25rem 1rem;
  grid-template-columns: 6rem minmax(0, 1fr);
  padding: 0.85rem 0;
}

.recent-item:hover {
  background: transparent;
  color: inherit;
}

.recent-item:hover .title {
  color: var(--primary-color);
}

.label {
  color: var(--text-2);
  font-family: var(--mono-text-font);
  font-size: 0.8rem;
}

.title {
  font-weight: 600;
}

.description {
  color: var(--text-1);
  grid-column: 2;
}

@media (max-width: 640px) {
  .recent-item {
    grid-template-columns: 1fr;
  }

  .description {
    grid-column: 1;
  }
}
</style>
