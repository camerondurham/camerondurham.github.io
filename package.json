{
  "name": "y",
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && npx pagefind --site dist",
    "preview": "astro preview",
    "astro": "astro",
    "check": "astro check",
    "test": "npm run test:unit && npm run test:e2e",
    "test:unit": "node --experimental-strip-types --test tests/*.test.mjs",
    "test:e2e": "playwright test",
    "cf:deploy": "npm run build && npx wrangler pages deploy dist",
    "cf:dev": "npm run build && npx wrangler pages dev dist"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.9",
    "@astrojs/rss": "^4.0.18",
    "@astrojs/sitemap": "^3.7.2",
    "astro": "^7.1.3",
    "pagefind": "^1.4.0",
    "typescript": "^5.9.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1"
  }
}
