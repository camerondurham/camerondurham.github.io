# Public submission URL, not an API secret. Leave empty to keep intake closed.
# Create your own Formspree form with CAPTCHA/email requirements off, then set
# https://formspree.io/f/<your-form-id> locally and in wrangler.jsonc for Pages.
PUBLIC_GUESTBOOK_FORM_URL=

# Optional read-only Analytics Engine report. Create a token with Account
# Analytics Read permission; never commit the real token.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ANALYTICS_DATASET=u64_page_requests

# Explicit D1 opt-in; unset preserves Formspree/closed-intake behavior.
# PUBLIC_GUESTBOOK_BACKEND=d1
