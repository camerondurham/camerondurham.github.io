{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Set this to your existing Cloudflare Pages project name.
  // You can generate a full file from Cloudflare with:
  // npx wrangler pages download config <PROJECT_NAME>
  "name": "camerondurham-github-io",
  "compatibility_date": "2026-10-23",
  "pages_build_output_dir": "dist",
  // D1 intake. Binding and private salt must be configured before cutover.
  "vars": {
    "PUBLIC_GUESTBOOK_BACKEND": "d1",
    "GUESTBOOK_IP_MODE": "trusted-cf"
  },
  // Pages reads build variables from this file, not the dashboard.
  "env": {
    "production": {
      "vars": {
        "PUBLIC_GUESTBOOK_BACKEND": "d1",
        "GUESTBOOK_IP_MODE": "trusted-cf"
      },
      "analytics_engine_datasets": [
        {
          "binding": "SCRAPER_ANALYTICS",
          "dataset": "u64_page_requests"
        }
      ]
    },
    "preview": {
      "vars": {
        "PUBLIC_GUESTBOOK_BACKEND": "d1",
        "GUESTBOOK_IP_MODE": "trusted-cf"
      },
      "analytics_engine_datasets": [
        {
          "binding": "SCRAPER_ANALYTICS",
          "dataset": "u64_page_requests_preview"
        }
      ]
    }
  }
}
